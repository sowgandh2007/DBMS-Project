# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# How to get your connection string from Supabase:
# 1. Log in to your Supabase project dashboard (https://supabase.com/dashboard).
# 2. Go to Project Settings -> Database.
# 3. Under "Connection string", select "URI" (or "Transaction pooler" / "Direct connection").
# 4. Copy the URI and replace [YOUR-PASSWORD] with your actual database password.
# ==============================================================================

# Option 1: Full PostgreSQL URI (Recommended for Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option 2: Individual Connection Parameters (Alternative)
PGHOST=db.[YOUR-PROJECT-REF].supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=[YOUR-PASSWORD]
PGSSLMODE=require

# Server Configuration
PORT=5000
FLASK_DEBUG=1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
